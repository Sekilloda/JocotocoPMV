# Environment configuration for Jocotoco Smart Monitor PoC

# Application Port
PORT=8000

# Directory for clips, local SQLite buffers, and device keys
DATA_DIR=data

# Supabase PostgreSQL Connection String
# Get this from your Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or using the Supabase Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Project URL & Anon/Service Role Key (Optional for REST / Storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]

# Cloudflare R2 / S3 Storage (Optional)
S3_ENDPOINT_URL=https://[ACCOUNT_ID].r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=jocotoco-media
